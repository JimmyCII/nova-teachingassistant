# Google Gemini API Key (from AI Studio: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Google AI Studio / Cloud project ID (used for Vertex AI / Live API / deployment)
GOOGLE_CLOUD_PROJECT=your_project_id_here

# Canvas LMS
CANVAS_API_URL=https://YOUR_DISTRICT.instructure.com
CANVAS_API_TOKEN=your_canvas_token_here

# Optional: Google Drive folder ID for Synergy grade exports
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Agent config
AGENT_MODEL=gemini-2.0-flash
GRADE_THRESHOLD=0.70
